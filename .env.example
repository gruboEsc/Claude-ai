# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...

# Ключ Claude API: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Твой Telegram id (через запятую, если несколько) — доступ к /admin и безлимит
ADMIN_IDS=

# Собеседник
COMPANION_NAME=Аня
# f — девушка, m — парень
COMPANION_GENDER=f

# Тарифы: 2 недели и месяц
FREE_MESSAGES=30
PRICE_RUB_14=990
PRICE_RUB_30=1790
# В звёздах: месяц — подписка с автопродлением, 2 недели — разовая оплата
PRICE_STARS_14=650
PRICE_STARS_30=1150
# Куда писать по вопросам оплаты (обязательно для платежей в Telegram), например @username
SUPPORT_CONTACT=

# ЮKassa: оплата картой, СБП, SberPay (пусто — только звёзды)
# shopId и секретный ключ — в личном кабинете ЮKassa → Интеграция → Ключи API
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Ставка НДС для чека: 1 — без НДС (см. справочник vat_code в документации ЮKassa)
YOOKASSA_VAT_CODE=1
# Автопродление с сохранённой карты. Включай, только когда ЮKassa подключит
# магазину автоплатежи (по заявке через менеджера)
YOOKASSA_AUTOPAY=0

# Лимит расходов на API на одного подписчика, в долларах (чтобы один человек не съел всё):
# не больше DAILY в день и не больше AVG_DAILY × дней тарифа за оплаченный срок
# (месяц — $12, 2 недели — $5.60)
DAILY_LIMIT_USD=0.60
AVG_DAILY_LIMIT_USD=0.40

# Писать первым, если человек долго молчит (только подписчикам)
CHECKINS=1
CHECKIN_AFTER_HOURS=20
CHECKIN_FROM_HOUR=10
CHECKIN_TO_HOUR=21

# Необязательно
CLAUDE_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max — глубже = умнее, но дороже и медленнее
EFFORT=low
MAX_TOKENS=16000
WEB_SEARCH=1
TIMEZONE=Europe/Moscow
DB_PATH=data/bot.db
# Закрытый режим: только эти id (пусто — открыт всем)
ALLOWED_USERS=
