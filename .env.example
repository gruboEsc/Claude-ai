# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...

# Ключ Claude API: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Кому можно пользоваться ботом (Telegram user id через запятую).
# Пусто = всем. Свой id бот покажет в ответ на /start.
ALLOWED_USERS=

# Необязательно
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
DEFAULT_EFFORT=medium
MAX_TOKENS=32000
WEB_SEARCH=1
DB_PATH=data/bot.db
# Часовой пояс для напоминаний
TIMEZONE=Europe/Moscow
